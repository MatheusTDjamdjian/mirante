  "scripts": {
    "prepare": "husky",
    "dev:infra": "docker compose up -d --wait",
    "dev:infra:down": "docker compose down",
    "dev:infra:logs": "docker compose logs -f",
    "dev:infra:verificar": "node tools/verificar-infra.mjs",
    "db:migrar": "node-pg-migrate up --envPath .env -m libs/persistence/migrations -j ts --migrations-table migracoes --check-order --verbose",
    "db:reverter": "node-pg-migrate down --envPath .env -m libs/persistence/migrations -j ts --migrations-table migracoes --verbose",
    "db:migracao:nova": "node-pg-migrate create --envPath .env -m libs/persistence/migrations -j ts",
    "verificar:fronteiras": "node tools/verificar-fronteiras.mjs",
    "verificar:hnsw": "node tools/verificar-indice-hnsw.mjs",
    "coletar:uma-vez": "nx build ingestion-worker && node --env-file=.env dist/apps/ingestion-worker/main.js --uma-vez",
    "worker": "nx build ingestion-worker && node --env-file=.env dist/apps/ingestion-worker/main.js"
  },
