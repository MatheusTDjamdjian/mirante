# Copie este arquivo para .env e preencha os valores locais.
# O .env e ignorado pelo git. Nenhum valor real entra neste arquivo.
#
# Se `npm run dev:infra` falhar com "port is already allocated", ha outro
# Postgres ou Redis na maquina. Troque POSTGRES_PORT / REDIS_PORT aqui e
# reflita a mesma porta em DATABASE_URL / REDIS_URL. Nada mais precisa mudar:
# o docker-compose.yml le as duas variaveis.

# --- Postgres local (docker-compose) ---
POSTGRES_USER=mirante
POSTGRES_PASSWORD=<defina-uma-senha-local>
POSTGRES_DB=mirante
POSTGRES_PORT=5432

# --- Conexao usada pela aplicacao e pelas migracoes ---
# Precisa refletir usuario, senha, porta e banco definidos acima.
DATABASE_URL=postgresql://mirante:<defina-uma-senha-local>@localhost:5432/mirante

# --- Redis local (docker-compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- ingestion-worker ---
# Intervalo entre ciclos de coleta. Default 5 min. Medido: o feed do InfoMoney
# mantem 10 itens cobrindo ~30 min, entao intervalo acima disso perde item.
INTERVALO_COLETA_MS=300000
# Timeout de uma requisicao a uma fonte.
TIMEOUT_FONTE_MS=10000
# fatal | error | warn | info | debug | trace
LOG_NIVEL=info